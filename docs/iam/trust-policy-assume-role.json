{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudOpsAIAssumeWithExternalId",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::ACCOUNT_ID:user/BASE_IDENTITY" },
      "Action": "sts:AssumeRole",
      "Condition": { "StringEquals": { "sts:ExternalId": "EXTERNAL_ID" } }
    }
  ]
}
