{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://cloudops-ai-api.vercel.app/api/:path*" },
    { "source": "/health", "destination": "https://cloudops-ai-api.vercel.app/health" }
  ]
}
