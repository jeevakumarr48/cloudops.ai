# AWS uses the standard boto3 credential chain. Do not commit credentials.
AWS_DEFAULT_REGION=us-east-1

# Optional AI explanation provider.
# CLOUDOPS_AI_API_KEY=
# OPENAI_API_KEY=
# CLOUDOPS_AI_BASE_URL=
# CLOUDOPS_AI_MODEL=

# Optional Infracost integration marker.
# INFRACOST_API_KEY=

# Comma-separated browser origins allowed to call FastAPI.
CLOUDOPS_AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173