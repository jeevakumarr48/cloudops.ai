# AWS uses the standard boto3 credential chain. Do not commit credentials.
AWS_DEFAULT_REGION=us-east-1

# Optional AI explanation provider.
# CLOUDOPS_AI_API_KEY=
# OPENAI_API_KEY=
# CLOUDOPS_AI_BASE_URL=
# CLOUDOPS_AI_MODEL=
# Recommendation rewrites: none (default) | ollama | openai_compatible
# CLOUDOPS_AI_PROVIDER=none
# CLOUDOPS_AI_DAILY_CALL_LIMIT=20

# Public demo at /api/demo/* (sample data only, no AWS, no database writes, no AI).
# Set to false to turn it off.
# CLOUDOPS_DEMO_ENABLED=true

# Optional role-based AWS access (no stored keys with Vercel OIDC); see docs/iam/README.md
# CLOUDOPS_AWS_ROLE_ARN=
# CLOUDOPS_AWS_EXTERNAL_ID=
# CLOUDOPS_AWS_AUTH=auto

# Optional Infracost integration marker.
# INFRACOST_API_KEY=

# Comma-separated browser origins allowed to call FastAPI.
CLOUDOPS_AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Multi-user persistence. Leave unset locally to use ./cloudops.db (SQLite).
# Required on Vercel for accounts and workspaces; use Neon's *pooled* string.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Set to false only for local HTTP development.
# CLOUDOPS_COOKIE_SECURE=true
# CLOUDOPS_SESSION_DAYS=7
# CLOUDOPS_REGISTRATION_OPEN=true
# Hard cap on billed Cost Explorer requests per month ($0.01 each).
# CLOUDOPS_CE_MONTHLY_CALL_LIMIT=75
# Who may view security findings for this deployment's own AWS account.
# CLOUDOPS_OPERATOR_EMAILS=you@example.com
# Serve S3 findings anonymously (demo accounts with harmless buckets only).
# CLOUDOPS_PUBLIC_SECURITY_FINDINGS=false
