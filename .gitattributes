# Keep Unix line endings for files that run inside Linux containers or CI,
# even on a Windows checkout with core.autocrlf=true.
* text=auto
*.sh text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.png binary
*.tf text eol=lf
*.tftest.hcl text eol=lf
.terraform.lock.hcl text eol=lf
